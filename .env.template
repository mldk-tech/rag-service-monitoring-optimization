# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_mongodb_password_here

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# Monitoring Configuration
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here

# Service Configuration
RAG_SERVICE_ENV=production
RAG_SERVICE_LOG_LEVEL=INFO
RAG_SERVICE_PORT=8000
RAG_SERVICE_METRICS_PORT=9090

# Database Connection URLs
ELASTICSEARCH_URL=http://elasticsearch:9200
MONGODB_URL=mongodb://mongodb:27017
REDIS_URL=redis://redis:6379

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100

# Monitoring Configuration
ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_LOGGING=true

# Resource Limits
MAX_CONNECTIONS=1000
MAX_POOL_SIZE=100
CONNECTION_TIMEOUT=5

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=10000

# Model Configuration
DEFAULT_MODEL=gpt-3.5-turbo
MAX_TOKENS=1000
TEMPERATURE=0.7

# Optimization Configuration
OPTIMIZATION_ENABLED=true
OPTIMIZATION_INTERVAL=3600

# Alert Configuration
ALERT_ENABLED=true
ALERT_THRESHOLD_ERROR_RATE=0.01
ALERT_THRESHOLD_LATENCY=1.0
ALERT_THRESHOLD_MEMORY=0.9
ALERT_THRESHOLD_CPU=0.8 